# Base config
SECRET_KEY=test-key
DATABASE_URL=postgresql+psycopg://in-time:in-time@localhost:5432/in-time
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
PHOTOS_DIR=./photos
SNAPSHOTS_DIR=./snapshots

DEPARTMENTS=Sales,Direction,Manager

# Number of reverse proxies in front of the app (1 with nginx), needed for the relay IP check
TRUSTED_PROXIES=0

# If the Main server is beside CloudFlare Proxy
# TRUSTED_PROXIE must be 1 if your archi looks like: CF -> Nginx -> Main_server
CF_PROXY=false

# CloudFlare IPs file
CF_IPS_FILE=cf_ips.txt

# Server for Gunicorn, it doesn't affect running it
# with python main.py
SERVER=127.0.0.1:8000
WORKERS=2
