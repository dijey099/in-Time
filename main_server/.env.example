# Base config. The server refuses to start with the placeholder values below.
# Long random value: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-string
DATABASE_URL=postgresql+psycopg://in-time:change-me@localhost:5432/in-time
ADMIN_USERNAME=admin
# At least 12 characters
ADMIN_PASSWORD=replace-with-a-strong-password
# After this many failed admin logins in a row the login is locked until the lock file is deleted
# on this server (or: flask --app main unlock-admin). Default 5, file admin_login.lock next to .env.
LOGIN_MAX_FAILURES=5
# ADMIN_LOCK_FILE=admin_login.lock
# true when the admin console is served over HTTPS (recommended)
SESSION_COOKIE_SECURE=false
PHOTOS_DIR=./photos
SNAPSHOTS_DIR=./snapshots

# Source code link shown in the admin console footer. in-Time is AGPL-3.0: if you run a modified
# version, publish your changes and put their address here.
SOURCE_URL=https://github.com/dijey099/in-Time

# Map used to pick a relay's site area (Relays page). Defaults to OpenStreetMap's free, volunteer-run
# servers (fine for a few admins; see https://operations.osmfoundation.org/policies/tiles/).
# Use another tile provider for heavier use, with its attribution. Empty MAP_SEARCH_URL hides address search.
# MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# MAP_TILE_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
# MAP_SEARCH_URL=https://nominatim.openstreetmap.org/search

# Number of reverse proxies in front of the app (1 with nginx), needed for the relay IP check
TRUSTED_PROXIES=0
# Addresses of those proxies (comma separated IPs/CIDR). Forwarded headers from anyone else are ignored.
TRUSTED_PEERS=127.0.0.1/32,::1/128

# If the Main server is behind Cloudflare Proxy
# TRUSTED_PROXIES must be 1 if your setup looks like: CF -> Nginx -> Main_server
CF_PROXY=false

# CloudFlare IPs file
CF_IPS_FILE=cf_ips.txt

# Address for Gunicorn (systemd service). Keep 127.0.0.1 behind nginx; use the LAN IP only for
# local relays, never 0.0.0.0 on a server reachable from the internet.
SERVER=127.0.0.1:8000
WORKERS=2
