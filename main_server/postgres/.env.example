# Copy to postgres/.env and set a strong password for production.
# Use the same values in main_server/.env -> DATABASE_URL.
# Note: the password only applies when the database is first created (empty data/ folder).
POSTGRES_USER=in-time
POSTGRES_PASSWORD=change-me
POSTGRES_DB=in-time
# Use 127.0.0.1:5432 to keep the database off the network
POSTGRES_PORT=127.0.0.1:5432
