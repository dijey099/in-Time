[Unit]
Description=in-Time main server (admin console + relay API)
Documentation=https://github.com/dijey099/in-Time
After=network-online.target postgresql.service docker.service
Wants=network-online.target

[Service]
Type=simple
User=in-time
Group=in-time
WorkingDirectory=/var/lib/in-time/main-server

Environment=PYTHONUNBUFFERED=1

# Settings: main.conf in the working directory (address and processes: [server] bind / workers)
ExecStart=/var/lib/in-time/main-server/.venv/bin/gunicorn -c gunicorn.conf.py main:app

Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
