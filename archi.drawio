        <mxCell id="kXz-IsJ1Zod-twu6_9E3-70" parent="1" style="html=1;outlineConnect=0;whiteSpace=wrap;fillColor=#99ff99;shape=mxgraph.archimate.application;appType=artifact;fontSize=19;align=left;verticalAlign=middle;" value="&lt;div&gt;- Expose public API to receive data from Relay server&lt;/div&gt;- Use token and IP Address to authenticate Relay server&lt;div&gt;- Store users info: ID, Full name, Photo path (photo rename to ID.jpg/png and are stored in directory /photos)&lt;/div&gt;" vertex="1">
          <mxGeometry height="330" width="205" x="-30" y="580" as="geometry" />
        </mxCell>
        <mxCell id="kXz-IsJ1Zod-twu6_9E3-71" parent="1" style="html=1;outlineConnect=0;whiteSpace=wrap;fillColor=#dae8fc;shape=mxgraph.archimate.application;appType=artifact;fontSize=19;align=left;verticalAlign=middle;strokeColor=#6c8ebf;" value="&lt;div&gt;- Expose private API to receive data from user phone connected to the same network&lt;/div&gt;- Store HTML, CSS &amp;amp; JS used by user&#39;s phone as face recognition client&lt;div&gt;- Cache users info for face recognition.&lt;br&gt;&lt;div&gt;- GUI that shows all users checking with a status OK or KO and synced with Main server or not (represented by cloud icon), shows Main server status Reachable, Unreachable or Error (auth token invalid)&lt;/div&gt;&lt;/div&gt;&lt;div&gt;- Cache checking in case of Main server is unavailable / Sync checking&lt;/div&gt;&lt;div&gt;- Ability to fecth settings from Main server (Max in time: late, Min out time)&lt;/div&gt;" vertex="1">
          <mxGeometry height="677.75" width="205" x="323" y="-410" as="geometry" />
