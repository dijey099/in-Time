# ---------------------------------------------------------------- secrets
# Never commit real configuration: it holds passwords and relay tokens.
.env
*.env
!.env.example
relay_server/relay.ini

# ------------------------------------------------- personal / runtime data
# User photos and check-in snapshots are biometric data.
main_server/photos/
main_server/snapshots/
relay_server/data/
relay_server/start_relay.exe
relay_server/start_relay
main_server/postgres/data/
*.db
*.db-shm
*.db-wal
*.sqlite3
*.log

# TLS material generated by the relay
*.key
*.pem
*.crt

# ------------------------------------------- downloaded face-api.js models
# Fetched automatically at start-up.
main_server/app/static/vendor/
relay_server/relay/web/vendor/
# Server-side face recognition models (OpenCV), downloaded at start-up
main_server/models/
*.onnx
*.part

